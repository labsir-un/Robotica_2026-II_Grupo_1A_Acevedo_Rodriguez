    ENDPROC

    PROC Posicionar_Banda()
        RESET FWD_Conveyor;
        RESET BWD_Conveyor;
        SET BWD_Conveyor;
        WaitTime(2.591);
        RESET BWD_Conveyor;
        
    ENDPROC
    PROC main()        
        RESET FWD_Conveyor;
        RESET BWD_Conveyor;
        RESET DO_01;
        RESET DO_02;
        RESET DO_03;
        WHILE TRUE DO
            IF DI_01=1 THEN
                
                SET BWD_Conveyor;
                SET FWD_Conveyor;
                WaitTime(2.591);
                RESET FWD_Conveyor;           
                RESET BWD_Conveyor;
                SET DO_01;
                Real_Home;
                Home_1;
                Zona_Dibujo;
                J;
                Zona_Dibujo;
                O;
                Zona_Dibujo;
                S;
                Zona_Dibujo;
                E;
                Zona_Dibujo;
                L;
                Zona_Dibujo;
                E_2;
                Zona_Dibujo;
                O_2;
                Zona_Dibujo;
                N;
                Zona_Dibujo;
                A;
                Zona_Dibujo;
                R;
                Zona_Dibujo;
                D;
                Zona_Dibujo;
                O_3;
                Zona_Dibujo;
                Pokeball;
                Zona_Dibujo;
                DibujarPikachu;
                RESET DO_01;
                Home_F;
                
                
                
                SET BWD_Conveyor;           
                SET FWD_Conveyor;
                WaitTime(1);
                RESET FWD_Conveyor;           
                RESET BWD_Conveyor;
                
                
            ELSEIF DI_03=1 THEN
                SET DO_03;
                Real_Home;
                Aura;
                Real_Home;
                RESET DO_03;
            ELSEIF DI_02=1 THEN
                SET DO_02;
                Mantenimiento_p;
                WHILE DI_02 = 1 DO        
                ENDWHILE
                IF DI_01 = 1 OR DI_03=1 THEN
                    Real_Home;
                    RESET DO_02;
                ENDIF
            ELSE
            ENDIF
        ENDWHILE
    ENDPROC
    
    PROC Mantenimiento_p()
        MoveJ Home_F2,v100,z1,MyNewTool\WObj:=Workobject_1;
        MoveJ Mantenimiento,v100,z1,MyNewTool\WObj:=Workobject_1;
    ENDPROC

ENDMODULE